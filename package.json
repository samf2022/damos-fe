{
	"name": "damos-fe",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types >/dev/null && vite build",
		"preview": "pnpm build && wrangler dev --port 4173",
		"prepare": "wrangler types >/dev/null && svelte-kit sync || echo \"\"",
		"check": "wrangler types >/dev/null && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"test:e2e": "playwright test",
		"gen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply damos-fe-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply damos-fe-db --remote",
		"db:reset:local": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate:local",
		"create-admin": "node scripts/create-admin.ts",
		"deploy": "pnpm build && wrangler deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/pdfmake": "^0.3.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"pdfmake": "^0.3.12"
	},
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@12.14.0"
}
