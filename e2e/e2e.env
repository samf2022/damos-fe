# Variables for the end-to-end test server only (loaded instead of .dev.vars when E2E=1).
# The Turnstile keys are Cloudflare's public testing keys: the widget always passes
# without a challenge. https://developers.cloudflare.com/turnstile/troubleshooting/testing/
APP_URL=http://localhost:5180
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
